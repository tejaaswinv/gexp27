# Copy to .env.local; server-side only. Never use NEXT_PUBLIC_ for API keys.
# This project supports OpenAI-compatible and Anthropic Messages endpoints.
# The configuration below matches the provided Claude-compatible Miaoqu AI provider.
ZAO_API_KEY=
ZAO_MODEL=claude-sonnet-5-5
ZAO_API_PROTOCOL=anthropic
ZAO_API_BASE_URL=https://api.miaoquai.com/v1
