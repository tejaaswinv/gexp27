# Sub2API / Miaoqu DeepSeek V4 (server only, never NEXT_PUBLIC_).
# If SUB2API_API_KEY is absent, the existing ZAO_API_KEY is reused.
# The remaining ZAO_* names are retained for backwards-compatible Vercel config.
ZAO_API_KEY=
ZAO_MODEL=deepseek-v4-pro-ga-260813
ZAO_API_PROTOCOL=responses
ZAO_FALLBACK_MODEL=deepseek-v4-1-flash-260910
ZAO_API_BASE_URL=https://api.miaoquai.com/v1
# Optional dedicated Sub2API overrides:
# SUB2API_API_KEY=
# SUB2API_MODEL=deepseek-v4-pro-ga-260813
# SUB2API_WIRE_API=responses
# SUB2API_BASE_URL=https://api.miaoquai.com/v1
